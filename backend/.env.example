# Runtime mode: local, test, or production.
APP_ENV=local
# Railway supplies PORT automatically in production.
PORT=8080
# Local development only. Production must use a TLS-enabled Supabase Postgres URL.
DATABASE_URL=postgres://postgres:replace_with_local_password@127.0.0.1:5432/sitaara?sslmode=disable
# Supported values: debug, info, warn, or error.
LOG_LEVEL=debug
# Keep this conservative for hosted poolers.
DB_MAX_CONNECTIONS=5

# Phase 2 authentication. Generate independent values of at least 32 characters.
JWT_SECRET=replace_with_a_high_entropy_local_secret
JWT_ISSUER=sitaara-api
JWT_AUDIENCE=sitaara-mobile
INVITE_HMAC_SECRET=replace_with_a_distinct_high_entropy_local_secret
REFRESH_HMAC_SECRET=replace_with_another_distinct_high_entropy_local_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Required only by the deterministic content metadata seed.
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
