# Runtime mode: local, test, or production.
APP_ENV=local
# Railway supplies PORT automatically in production.
PORT=8080
# Local development only. Production must use a TLS-enabled Supabase Postgres URL.
DATABASE_URL=postgres://postgres:replace_with_local_password@127.0.0.1:5432/sitaara?sslmode=disable
# Supported values: debug, info, warn, or error.
LOG_LEVEL=debug
# Keep this conservative for hosted poolers.
DB_MAX_CONNECTIONS=5
